<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= title %> | DocFlow</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body>
    <main class="public-shell">
      <div class="public-panel">
        <div class="brand-mark">DocFlow</div>
        <span class="eyebrow">CHECKLIST DE <%= processo.cliente.nome %></span>
        <h1><%= processo.nomeProcesso %></h1>
        <p class="text-muted">Envie os documentos pendentes abaixo.</p>
        <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
        <% } %><% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
        <% } %><% if (!completed) { %><% processo.documentos.filter(doc => doc.status ===
        'PENDENTE').forEach(doc => { %>
        <form method="post" enctype="multipart/form-data" class="upload-row">
          <input type="hidden" name="documentoId" value="<%= doc.id %>" />
          <div>
            <strong><%= doc.nomeDocumento %></strong
            ><small class="d-block text-muted">PDF, JPG ou PNG</small>
          </div>
          <input
            class="form-control"
            type="file"
            name="arquivo"
            accept=".pdf,.jpg,.jpeg,.png"
            required
          /><button class="btn btn-primary">Enviar</button>
        </form>
        <% }) %><% } %>
      </div>
    </main>
  </body>
</html>
