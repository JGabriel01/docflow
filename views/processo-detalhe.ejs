<%- include('partials/layout', { body: `
<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <span class="eyebrow">${escapeHtml(processo.cliente.nome)}</span>
    <h1>${escapeHtml(processo.nomeProcesso)}</h1>
    <span
      class="badge ${processo.status === 'CONCLUIDO' ? 'bg-success' : 'bg-warning text-dark'}"
      >${processo.status === 'CONCLUIDO' ? 'Concluído' : 'Em andamento'}</span
    >
  </div>
  <div>
    <a href="/processos/${processo.id}/editar" class="btn btn-outline-secondary"
      >Editar</a
    >
    <form
      class="d-inline"
      method="post"
      action="/processos/${processo.id}/excluir"
    >
      <button class="btn btn-outline-danger">Excluir</button>
    </form>
  </div>
</div>
<section class="form-panel mb-4">
  <label class="form-label">Link de envio</label>
  <div class="input-group">
    <input
      id="upload-link"
      class="form-control"
      value="${escapeHtml(link)}"
      readonly
    /><button class="btn btn-outline-secondary" data-copy="upload-link">
      Copiar
    </button>
  </div>
  <form
    class="row g-2 mt-2"
    method="post"
    action="/processos/${processo.id}/enviar-link"
  >
    <div class="col-md-4">
      <select class="form-select" name="canalEnvio">
        <option value="EMAIL">E-mail</option>
        <option value="WHATSAPP">WhatsApp</option>
      </select>
    </div>
    <div class="col-md-4">
      <button class="btn btn-primary">Enviar link</button>
    </div>
  </form>
</section>
<div class="table-responsive">
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Documento</th>
        <th>Status</th>
        <th>Envio</th>
      </tr>
    </thead>
    <tbody>
      ${processo.documentos.map(doc => `
      <tr>
        <td>${escapeHtml(doc.nomeDocumento)}</td>
        <td>
          <span
            class="badge ${doc.status === 'RECEBIDO' ? 'bg-success' : 'bg-warning text-dark'}"
            >${doc.status === 'RECEBIDO' ? 'Recebido' : 'Pendente'}</span
          >
        </td>
        <td>
          ${doc.dataEnvio ? new Date(doc.dataEnvio).toLocaleDateString('pt-BR') : 'Aguardando'}
          ${doc.status === 'RECEBIDO' ? `<a class="btn btn-sm btn-link" href="/upload/documentos/${doc.id}/download">Baixar</a>` : ''}
        </td>
      </tr>
      `).join('')}
    </tbody>
  </table>
</div>
` }) %>
