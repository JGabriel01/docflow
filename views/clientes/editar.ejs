<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card shadow-sm">
      <div class="card-header bg-white py-3">
        <h5 class="card-title fw-bold mb-0">
          <i class="bi bi-pencil-square text-primary me-2"></i>Editar Cliente
        </h5>
      </div>
      <div class="card-body p-4">
        <form action="/clientes/<%= cliente.id %>/editar" method="POST" novalidate>
          <div class="mb-3">
            <label for="nome" class="form-label fw-semibold">Nome Completo *</label>
            <input
              type="text"
              class="form-control <%= typeof errors !== 'undefined' && errors.nome ? 'is-invalid' : '' %>"
              id="nome"
              name="nome"
              value="<%= typeof dados !== 'undefined' && dados.nome ? dados.nome : cliente.nome %>"
              required
            >
            <% if (typeof errors !== 'undefined' && errors.nome) { %>
              <div class="invalid-feedback"><%= errors.nome %></div>
            <% } %>
          </div>

          <div class="mb-3">
            <label for="cpf" class="form-label fw-semibold">CPF *</label>
            <input
              type="text"
              class="form-control <%= typeof errors !== 'undefined' && errors.cpf ? 'is-invalid' : '' %>"
              id="cpf"
              name="cpf"
              value="<%= typeof dados !== 'undefined' && dados.cpf ? dados.cpf : cliente.cpf %>"
              required
            >
            <% if (typeof errors !== 'undefined' && errors.cpf) { %>
              <div class="invalid-feedback"><%= errors.cpf %></div>
            <% } %>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="email" class="form-label fw-semibold">E-mail (opcional)</label>
              <input
                type="email"
                class="form-control <%= typeof errors !== 'undefined' && errors.email ? 'is-invalid' : '' %>"
                id="email"
                name="email"
                value="<%= typeof dados !== 'undefined' && dados.email !== undefined ? dados.email : (cliente.email || '') %>"
              >
              <% if (typeof errors !== 'undefined' && errors.email) { %>
                <div class="invalid-feedback"><%= errors.email %></div>
              <% } %>
            </div>

            <div class="col-md-6 mb-3">
              <label for="telefone" class="form-label fw-semibold">Telefone / WhatsApp (opcional)</label>
              <input
                type="text"
                class="form-control <%= typeof errors !== 'undefined' && errors.telefone ? 'is-invalid' : '' %>"
                id="telefone"
                name="telefone"
                value="<%= typeof dados !== 'undefined' && dados.telefone !== undefined ? dados.telefone : (cliente.telefone || '') %>"
              >
              <% if (typeof errors !== 'undefined' && errors.telefone) { %>
                <div class="invalid-feedback"><%= errors.telefone %></div>
              <% } %>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 mt-3">
            <a href="/clientes" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-save me-1"></i>Salvar Alterações
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
