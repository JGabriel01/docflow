<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cadastrar Empresa - DocFlow</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/theme.css">
  <script>
    (function() {
      const savedTheme = localStorage.getItem('docflow-theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 py-4 position-relative">
  <div class="position-absolute top-0 end-0 p-3">
    <button type="button" class="btn btn-sm btn-outline-secondary theme-toggle-btn rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 36px; height: 36px;" title="Alternar tema" aria-label="Alternar tema">
      <i class="bi bi-moon-stars theme-icon-dark"></i>
      <i class="bi bi-sun theme-icon-light d-none"></i>
    </button>
  </div>
  <div class="container" style="max-width: 520px;">
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle p-3 mb-2 shadow-sm">
        <i class="bi bi-folder-check fs-2"></i>
      </div>
      <h2 class="fw-bold mb-0">DocFlow</h2>
      <p class="text-muted">Crie a conta da sua empresa para gerenciar coletas</p>
    </div>

    <div class="card shadow-sm p-4">
      <%- include('../partials/_messages') %>

      <h4 class="card-title fw-semibold mb-3">Cadastro de Empresa</h4>
      <form action="/empresas/cadastro" method="POST" novalidate>
        <div class="mb-3">
          <label for="razaoSocial" class="form-label">Razão Social / Nome da Empresa</label>
          <input
            type="text"
            class="form-control <%= typeof errors !== 'undefined' && errors.razaoSocial ? 'is-invalid' : '' %>"
            id="razaoSocial"
            name="razaoSocial"
            value="<%= typeof dados !== 'undefined' && dados.razaoSocial ? dados.razaoSocial : '' %>"
            placeholder="Ex.: Contabilidade Silva LTDA"
            required
          >
          <% if (typeof errors !== 'undefined' && errors.razaoSocial) { %>
            <div class="invalid-feedback"><%= errors.razaoSocial %></div>
          <% } %>
        </div>

        <div class="mb-3">
          <label for="cnpj" class="form-label">CNPJ</label>
          <input
            type="text"
            class="form-control <%= typeof errors !== 'undefined' && errors.cnpj ? 'is-invalid' : '' %>"
            id="cnpj"
            name="cnpj"
            value="<%= typeof dados !== 'undefined' && dados.cnpj ? dados.cnpj : '' %>"
            placeholder="12.345.678/0001-90"
            required
          >
          <% if (typeof errors !== 'undefined' && errors.cnpj) { %>
            <div class="invalid-feedback"><%= errors.cnpj %></div>
          <% } %>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">E-mail de Login</label>
          <input
            type="email"
            class="form-control <%= typeof errors !== 'undefined' && errors.email ? 'is-invalid' : '' %>"
            id="email"
            name="email"
            value="<%= typeof dados !== 'undefined' && dados.email ? dados.email : '' %>"
            placeholder="contato@silva.com.br"
            required
          >
          <% if (typeof errors !== 'undefined' && errors.email) { %>
            <div class="invalid-feedback"><%= errors.email %></div>
          <% } %>
        </div>

        <div class="mb-3">
          <label for="senha" class="form-label">Senha de Acesso</label>
          <input
            type="password"
            class="form-control <%= typeof errors !== 'undefined' && errors.senha ? 'is-invalid' : '' %>"
            id="senha"
            name="senha"
            placeholder="Mínimo de 6 caracteres"
            required
          >
          <% if (typeof errors !== 'undefined' && errors.senha) { %>
            <div class="invalid-feedback"><%= errors.senha %></div>
          <% } %>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
          <i class="bi bi-check2-circle me-1"></i> Finalizar Cadastro
        </button>
      </form>

      <div class="text-center mt-3 pt-3 border-top">
        <span class="text-muted small">Já possui uma conta? </span>
        <a href="/login" class="small fw-semibold text-decoration-none">Acesse o sistema</a>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
