<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Link inválido | DocFlow</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body>
    <main class="public-shell">
      <div class="public-panel">
        <div class="brand-mark">DocFlow</div>
        <h1><%= typeof message !== "undefined" ? message : "Este link não é mais válido." %></h1>
        <p><%= typeof detail !== "undefined" ? detail : "Solicite um novo link à empresa responsável pelo seu processo." %></p>
      </div>
    </main>
  </body>
</html>
