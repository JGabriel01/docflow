<%- include('partials/layout', { body: `
<section class="auth-card">
  <span class="eyebrow">GESTÃO DE DOCUMENTOS</span>
  <h1>Entre no seu fluxo.</h1>
  <p class="text-muted">Acompanhe cada checklist em um só lugar.</p>
  <form method="post" action="/login">
    <label class="form-label">E-mail</label
    ><input
      class="form-control mb-3"
      type="email"
      name="email"
      value="${escapeHtml(form.email || '')}"
      required
    /><label class="form-label">Senha</label
    ><input class="form-control mb-2" type="password" name="senha" required />
    <div class="invalid-feedback d-block mb-3">${escapeHtml(errors.senha || '')}</div>
    <button class="btn btn-primary w-100">Entrar</button>
  </form>
  <a class="d-block mt-3 text-center" href="/empresas/cadastro"
    >Criar conta empresarial</a
  >
</section>
` }) %>
