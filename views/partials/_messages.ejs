<% if (typeof messages !== 'undefined') { %>
  <% if (messages.success && messages.success.length > 0) { %>
    <% messages.success.forEach(function(msg) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i><%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% }); %>
  <% } %>

  <% if (messages.danger && messages.danger.length > 0) { %>
    <% messages.danger.forEach(function(msg) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i><%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% }); %>
  <% } %>

  <% if (messages.warning && messages.warning.length > 0) { %>
    <% messages.warning.forEach(function(msg) { %>
      <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i><%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% }); %>
  <% } %>

  <% if (messages.info && messages.info.length > 0) { %>
    <% messages.info.forEach(function(msg) { %>
      <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i><%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% }); %>
  <% } %>
<% } %>
