<nav class="navbar navbar-expand-lg border-bottom sticky-top shadow-sm docflow-navbar">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="<%= typeof empresa !== 'undefined' && empresa ? '/processos' : '/' %>">
      <div class="brand-icon-box" style="width: 34px; height: 34px;">
        <i class="bi bi-folder-check text-white fs-5"></i>
      </div>
      <span class="brand-title" style="font-size: 1.25rem;">DocFlow</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarContent">
      <% if (typeof empresa !== 'undefined' && empresa) { %>
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/processos') ? 'active' : '' %>" href="/processos">
              <i class="bi bi-kanban me-1"></i>Processos
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/clientes') && !currentPath.includes('/historico') ? 'active' : '' %>" href="/clientes">
              <i class="bi bi-people me-1"></i>Clientes
            </a>
          </li>
          <% if (empresa.plano === 'PRO') { %>
            <li class="nav-item">
              <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.includes('/historico') ? 'active' : '' %>" href="<%= typeof cliente !== 'undefined' && cliente && cliente.id ? '/clientes/' + cliente.id + '/historico' : '/clientes/historico' %>">
                <i class="bi bi-clock-history me-1"></i>Histórico
              </a>
            </li>
          <% } %>
          <li class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/empresas') ? 'active' : '' %>" href="/empresas/perfil">
              <i class="bi bi-building me-1"></i>Minha Empresa
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/planos') ? 'active' : '' %>" href="/planos">
              <i class="bi bi-gem me-1"></i>Planos
            </a>
          </li>
        </ul>
        <div class="d-flex align-items-center navbar-user-actions ms-auto">
          <button type="button" class="btn btn-sm btn-outline-secondary theme-toggle-btn rounded-circle d-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 36px; height: 36px;" title="Alternar tema claro/escuro" aria-label="Alternar tema">
            <i class="bi bi-moon-stars theme-icon-dark"></i>
            <i class="bi bi-sun theme-icon-light d-none"></i>
          </button>
          <a href="/planos" class="text-decoration-none flex-shrink-0" title="Gerenciar Plano">
            <% if (empresa.plano === 'PRO') { %>
              <span class="badge badge-pro px-3 py-2 rounded-pill shadow-sm">
                <i class="bi bi-star-fill me-1"></i>PLANO PRO
              </span>
            <% } else { %>
              <span class="badge bg-secondary px-3 py-2 rounded-pill text-white">
                PLANO GRÁTIS &bull; <span class="text-warning fw-bold">Upgrade</span>
              </span>
            <% } %>
          </a>
          <div class="vr my-1 text-muted opacity-25 d-none d-sm-block flex-shrink-0" style="height: 22px;"></div>
          <div class="d-flex align-items-center gap-2 text-truncate" style="max-width: 190px;" title="<%= empresa.razaoSocial %>">
            <i class="bi bi-building text-muted flex-shrink-0"></i>
            <span class="small fw-semibold text-truncate" style="color: var(--df-text-main);">
              <%= empresa.razaoSocial %>
            </span>
          </div>
          <form action="/logout" method="POST" class="d-inline m-0 flex-shrink-0">
            <button type="submit" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1.5 px-3 py-1.5">
              <i class="bi bi-box-arrow-right"></i>
              <span>Sair</span>
            </button>
          </form>
        </div>
      <% } else { %>
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
          <li class="nav-item me-lg-2 my-2 my-lg-0">
            <button type="button" class="btn btn-sm btn-outline-secondary theme-toggle-btn rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 34px; height: 34px;" title="Alternar tema claro/escuro" aria-label="Alternar tema">
              <i class="bi bi-moon-stars theme-icon-dark"></i>
              <i class="bi bi-sun theme-icon-light d-none"></i>
            </button>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login">Entrar</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-primary btn-sm ms-lg-2" href="/empresas/cadastro">Cadastrar Empresa</a>
          </li>
        </ul>
      <% } %>
    </div>
  </div>
</nav>
