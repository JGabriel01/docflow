<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= title %> | DocFlow</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/processos">DocFlow</a
        ><button
          class="navbar-toggler"
          data-bs-toggle="collapse"
          data-bs-target="#nav"
        >
          Menu
        </button>
        <div id="nav" class="collapse navbar-collapse">
          <div class="navbar-nav me-auto">
            <a class="nav-link" href="/processos">Processos</a
            ><a class="nav-link" href="/clientes">Clientes</a
            ><a class="nav-link" href="/empresas/perfil">Empresa</a
            ><% if (empresa && empresa.plano === 'PRO') { %><a
              class="nav-link"
              href="/clientes"
              >Histórico Pro</a
            ><% } %>
          </div>
          <% if (empresa) { %>
          <form method="post" action="/logout">
            <button class="btn btn-outline-light btn-sm">Sair</button>
          </form>
          <% } %>
        </div>
      </div>
    </nav>
    <main class="container py-4"><%- include('_messages') %><%- body %></main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document
        .querySelectorAll("[data-copy]")
        .forEach((b) =>
          b.addEventListener("click", () =>
            navigator.clipboard.writeText(
              document.getElementById(b.dataset.copy).value,
            ),
          ),
        );
    </script>
  </body>
</html>
