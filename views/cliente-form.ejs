<%- include('partials/layout', { body: `
<div class="mb-4">
  <span class="eyebrow">CADASTRO</span>
  <h1>${title}</h1>
</div>
<form method="post" action="${action}" class="form-panel">
  <label class="form-label">Nome completo</label
  ><input
    class="form-control mb-1"
    name="nome"
    value="${form.nome || ''}"
    required
  />
  <div class="invalid-feedback d-block mb-3">${errors.nome || ''}</div>
  <label class="form-label">CPF</label
  ><input
    class="form-control mb-1"
    name="cpf"
    value="${form.cpf || ''}"
    required
  />
  <div class="invalid-feedback d-block mb-3">${errors.cpf || ''}</div>
  <label class="form-label">E-mail</label
  ><input
    class="form-control mb-3"
    type="email"
    name="email"
    value="${form.email || ''}"
  /><label class="form-label">Telefone / WhatsApp</label
  ><input
    class="form-control mb-4"
    name="telefone"
    value="${form.telefone || ''}"
  /><button class="btn btn-primary">Salvar cliente</button>
  <a class="btn btn-link" href="/clientes">Cancelar</a>
</form>
` }) %>
