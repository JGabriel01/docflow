<%- include('partials/layout', { body: `
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <span class="eyebrow">RELACIONAMENTO</span>
    <h1>Clientes</h1>
  </div>
  <a href="/clientes/novo" class="btn btn-primary">Novo cliente</a>
</div>
<form class="input-group mb-4">
  <input
    class="form-control"
    name="busca"
    value="${escapeHtml(busca)}"
    placeholder="Buscar por nome ou CPF"
  /><button class="btn btn-outline-secondary">Buscar</button>
</form>
<div class="table-responsive">
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Nome</th>
        <th>CPF</th>
        <th>Contato</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      ${clientes.map(cliente => `
      <tr>
        <td><strong>${escapeHtml(cliente.nome)}</strong></td>
        <td>${escapeHtml(cliente.cpf)}</td>
        <td>${escapeHtml(cliente.email || cliente.telefone || 'Sem contato')}</td>
        <td class="text-end">
          <a
            class="btn btn-sm btn-outline-secondary"
            href="/clientes/${cliente.id}/editar"
            >Editar</a
          >
          ${empresa && empresa.plano === 'PRO' ? `<a
            class="btn btn-sm btn-outline-primary"
            href="/clientes/${cliente.id}/historico"
            >Histórico</a
          >` : ''}
          <form
            class="d-inline"
            method="post"
            action="/clientes/${cliente.id}/excluir"
          >
            <button class="btn btn-sm btn-outline-danger">Excluir</button>
          </form>
        </td>
      </tr>
      `).join('') || '<tr><td colspan="4" class="text-muted">Nenhum cliente encontrado.</td></tr>'}
    </tbody>
  </table>
</div>
` }) %>
