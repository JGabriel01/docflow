<%- include('partials/header') %>

<div class="row justify-content-center text-center py-5">
  <div class="col-md-6">
    <div class="display-1 fw-bold text-muted mb-2">404</div>
    <h3 class="fw-bold mb-3">Página ou Recurso Não Encontrado</h3>
    <p class="text-muted mb-4">
      <%= typeof mensagem !== 'undefined' ? mensagem : 'O recurso que você tentou acessar não foi encontrado ou pertence a outra organização.' %>
    </p>
    <a href="<%= typeof empresa !== 'undefined' && empresa ? '/processos' : '/' %>" class="btn btn-primary px-4 py-2">
      <i class="bi bi-house-door me-1"></i><%= typeof empresa !== 'undefined' && empresa ? 'Voltar ao Painel' : 'Voltar ao Início' %>
    </a>
  </div>
</div>

<%- include('partials/footer') %>
