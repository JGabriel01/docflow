<%- include('partials/header') %>

<div class="row justify-content-center text-center py-5">
  <div class="col-md-6">
    <div class="display-1 fw-bold text-danger mb-2"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %></div>
    <h3 class="fw-bold mb-3">Erro no Sistema</h3>
    <p class="text-muted mb-4">
      <%= typeof mensagem !== 'undefined' ? mensagem : 'Ocorreu um erro inesperado ao processar sua solicitação.' %>
    </p>
    <a href="/processos" class="btn btn-primary">
      <i class="bi bi-arrow-left me-1"></i>Voltar ao Painel
    </a>
  </div>
</div>

<%- include('partials/footer') %>
